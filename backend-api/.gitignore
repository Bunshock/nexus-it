# Local reference/status docs — working notes, kept on disk but out of git.
# Anchored to this (backend-api/) directory; the old un-anchored pattern here
# was double-prefixed and never actually matched.
/NEXT-SESSION.md
/DB-SCHEMA.md
/IMPLEMENTED_ENDPOINTS.md
/MIDDLEWARE-COMPARE.md

# Local-only dev-seed addition (real usernames for testing against production Keycloak) —
# never commit, see NEXT-SESSION.md "Testing against production Keycloak".
/src/main/resources/dev-seed-local.sql

# Local-only config overrides (real Keycloak/AD directory values, incl. the directory
# bearer token) — never commit, see NEXT-SESSION.md "Testing against production Keycloak".
/src/main/resources/application-local.yml

# Filled-in provisioning scripts (real usernames, sites, inventory) — only the .example
# templates and README are tracked. See provisioning/README.md.
/provisioning/*.sql

# Local middleware run log from manual testing.
/mw-run.log
