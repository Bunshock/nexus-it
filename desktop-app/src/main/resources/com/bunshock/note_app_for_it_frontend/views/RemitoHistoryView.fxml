<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.RemitoHistoryController">
    <children>

        <!-- Filter panel -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18 20;">
            <children>

                <HBox spacing="28">

                    <VBox spacing="6">
                        <Label text="Fecha" styleClass="filter-section-label"/>
                        <HBox spacing="12">
                            <VBox spacing="3">
                                <Label text="DESDE" styleClass="input-label-small"/>
                                <DatePicker fx:id="dpFrom" promptText="dd/mm/aaaa"
                                            prefWidth="145" prefHeight="32" styleClass="form-input-filter"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label text="HASTA" styleClass="input-label-small"/>
                                <DatePicker fx:id="dpTo" promptText="dd/mm/aaaa"
                                            prefWidth="145" prefHeight="32" styleClass="form-input-filter"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Remito" styleClass="filter-section-label"/>
                        <HBox spacing="12">
                            <VBox spacing="3">
                                <Label text="ESTADO" styleClass="input-label-small"/>
                                <MenuButton fx:id="mnuApprovalStatus" text="Todas"
                                            prefWidth="150" prefHeight="32" styleClass="filter-menu-button"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label text="SEDE ORIGEN" styleClass="input-label-small"/>
                                <MenuButton fx:id="mnuSede" text="Todas"
                                            prefWidth="158" prefHeight="32" styleClass="filter-menu-button"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label text="DESTINO" styleClass="input-label-small"/>
                                <TextField fx:id="txtDestinationSearch" prefWidth="178" prefHeight="32"
                                           promptText="Buscar destino..."
                                           onAction="#handleSearch"
                                           styleClass="form-input-filter"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label text="AUTOR" styleClass="input-label-small"/>
                                <TextField fx:id="txtAuthorSearch" prefWidth="178" prefHeight="32"
                                           promptText="Buscar por autor..."
                                           onAction="#handleSearch"
                                           styleClass="form-input-filter"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Buscar" onAction="#handleSearch" styleClass="button-primary" prefHeight="32"/>
                    <Button text="Limpiar filtros" onAction="#handleClearFilters" styleClass="button-secondary" prefHeight="32"/>
                </HBox>

            </children>
        </VBox>

        <!-- Envíos table -->
        <VBox VBox.vgrow="ALWAYS" spacing="6"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <TableView fx:id="tblEnvios" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <placeholder>
                    <Label text="No hay remitos registrados."/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colEApproval"   text="" prefWidth="8" minWidth="8" maxWidth="8" resizable="false" sortable="false"/>
                    <TableColumn fx:id="colEDate"       text="FECHA"        prefWidth="140" maxWidth="155"/>
                    <TableColumn fx:id="colEAuthor"     text="AUTOR"        prefWidth="160" maxWidth="190"/>
                    <TableColumn fx:id="colESede"       text="SEDE ORIGEN"  prefWidth="130" maxWidth="160"/>
                    <TableColumn fx:id="colEDestination" text="DESTINO"     prefWidth="150"/>
                    <TableColumn fx:id="colEAddress"    text="DIRECCIÓN"    prefWidth="170"/>
                    <TableColumn fx:id="colERecipients" text="DESTINATARIOS" prefWidth="170"/>
                    <TableColumn fx:id="colEItems"      text="EQUIPOS"      prefWidth="90"  maxWidth="90"/>
                    <TableColumn fx:id="colEStatus"     text="ESTADO"       prefWidth="110" maxWidth="130"/>
                </columns>
            </TableView>
            <Label text="A = Activo (con S/N) · C = Contable (por cantidad) — ej.: &quot;2A / 3C&quot;"
                   maxWidth="Infinity" alignment="CENTER_RIGHT"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-alignment: center-right;"/>
        </VBox>

    </children>
</VBox>
