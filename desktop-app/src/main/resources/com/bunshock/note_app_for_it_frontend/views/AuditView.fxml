<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="rootContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.AuditController">
    <children>

        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <Label text="AUDITORÍA" styleClass="page-title"/>
        </HBox>

        <!-- Logins/Actions toggle -->
        <HBox prefHeight="46.0" spacing="0">
            <children>
                <ToggleButton fx:id="btnLogins" text="INICIOS DE SESIÓN"
                              minWidth="0" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="type-button-left" selected="true" toggleGroup="$auditGroup">
                    <toggleGroup>
                        <ToggleGroup fx:id="auditGroup"/>
                    </toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="btnActions" text="ACCIONES"
                              minWidth="0" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="type-button-right" toggleGroup="$auditGroup"/>
            </children>
        </HBox>

        <!-- Logins -->
        <VBox fx:id="rowLogins" spacing="10" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="INICIOS DE SESIÓN" styleClass="section-label"/>
                <TableView fx:id="tblLogins" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colLoginUser"   text="USUARIO"   prefWidth="200"/>
                        <TableColumn fx:id="colLoginDate"   text="FECHA"     prefWidth="180"/>
                        <TableColumn fx:id="colLoginResult" text="RESULTADO"/>
                    </columns>
                </TableView>
            </children>
        </VBox>

        <!-- Actions -->
        <VBox fx:id="rowActions" spacing="10" VBox.vgrow="ALWAYS" visible="false" managed="false"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="ACCIONES" styleClass="section-label"/>
                <TableView fx:id="tblActions" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colActionUser"   text="USUARIO" prefWidth="160"/>
                        <TableColumn fx:id="colActionDate"   text="FECHA"   prefWidth="180"/>
                        <TableColumn fx:id="colActionType"   text="ACCIÓN"  prefWidth="170"/>
                        <TableColumn fx:id="colActionDetail" text="DETALLE"/>
                    </columns>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>
