<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.ProfileController">
    <children>

        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <Label text="MI PERFIL" styleClass="page-title"/>
        </HBox>

        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="Estos datos se obtienen automáticamente desde Active Directory a partir de la sesión de Windows y se usan para completar los campos del técnico en las notas."
                       wrapText="true"
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>

                <Separator style="-fx-opacity: 0.5;"/>

                <VBox spacing="10" maxWidth="360">
                    <children>
                        <VBox spacing="2">
                            <Label text="NOMBRE COMPLETO" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileName" disable="true" styleClass="form-input-main"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="USERNAME" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileUsername" disable="true" styleClass="form-input-main"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="DNI" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileDni" disable="true" styleClass="form-input-main"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="EMAIL" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileEmail" disable="true" styleClass="form-input-main"/>
                        </VBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblProfileStatus" text="" style="-fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnRefreshFromAd" text="Actualizar Perfil desde AD" onAction="#handleRefreshFromAd" styleClass="button-secondary"/>
                    <Button fx:id="btnSave" text="Guardar" onAction="#handleSave" styleClass="button-primary" visible="false" managed="false"/>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="Nombre que se muestra en el saludo de la barra lateral (&quot;Hola ...!&quot;). Si se deja vacío, se usa un nombre sugerido a partir del nombre completo de Active Directory."
                       wrapText="true"
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>

                <Separator style="-fx-opacity: 0.5;"/>

                <VBox spacing="2" maxWidth="360">
                    <children>
                        <Label text="NOMBRE PARA MOSTRAR" styleClass="input-label-small"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="txtDisplayName" styleClass="form-input-main" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnResetDisplayName" text="↺" onAction="#handleResetDisplayName"
                                        styleClass="button-square-reset">
                                    <tooltip>
                                        <Tooltip text="Restablecer al nombre sugerido"/>
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblDisplayNameStatus" text="" style="-fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnSaveDisplayName" text="Guardar" onAction="#handleSaveDisplayName" styleClass="button-primary"/>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
