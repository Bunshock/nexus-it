<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.ProfileController">
    <children>

        <Label text="MI PERFIL" styleClass="section-label"/>

        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="Estos datos se usan para completar automáticamente los campos del técnico en las notas."
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <children>
                        <VBox spacing="2" GridPane.columnIndex="0">
                            <Label text="NOMBRE COMPLETO" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileName" styleClass="form-input-main"/>
                        </VBox>
                        <VBox spacing="2" GridPane.columnIndex="1">
                            <Label text="DNI" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileDni" styleClass="form-input-main"/>
                        </VBox>
                        <VBox spacing="2" GridPane.columnIndex="2">
                            <Label text="EMAIL" styleClass="input-label-small"/>
                            <TextField fx:id="txtProfileEmail" styleClass="form-input-main"/>
                        </VBox>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label fx:id="lblProfileStatus" text="" style="-fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Guardar" onAction="#handleSave" styleClass="button-primary"/>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
