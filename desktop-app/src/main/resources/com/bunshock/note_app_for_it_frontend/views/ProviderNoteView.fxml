<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="20" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.note.ProviderNoteController">
    <children>

        <!-- Motivo (mandatory) — right below the note-type combobox, no separator in between,
             matching UserNoteView (Motivo is its very first child too). -->
        <VBox spacing="4">
            <children>
                <Label text="MOTIVO" styleClass="input-label-small"/>
                <ComboBox fx:id="cmbMotivo" promptText="Seleccionar motivo..."
                          maxWidth="Infinity" styleClass="form-input-main"/>
            </children>
        </VBox>

        <Separator style="-fx-opacity: 0.5;"/>

        <!-- Provider selection -->
        <VBox spacing="10">
            <children>
                <Label text="DATOS DEL PROVEEDOR" styleClass="section-label"/>

                <VBox spacing="2">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="PROVEEDOR" styleClass="input-label-small"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblProviderStatus" text="" styleClass="input-label-small"/>
                            </children>
                        </HBox>
                        <ComboBox fx:id="cmbProviderSearch" promptText="Seleccionar proveedor..."
                                  maxWidth="Infinity" styleClass="form-input-main"/>
                    </children>
                </VBox>

                <VBox spacing="6">
                    <children>
                        <CheckBox fx:id="chkEnableCuit" text="CUIT"
                                  styleClass="custom-checkbox-inline"/>
                        <TextField fx:id="txtCuit" disable="true" promptText="XX-XXXXXXXX-X" styleClass="form-input-main"/>
                    </children>
                </VBox>
            </children>
        </VBox>

        <Separator style="-fx-opacity: 0.5;"/>

        <!-- Responsible person — trimmed spacing (was 18/14): this is the form's tallest section,
             and without a ScrollPane anymore (see NoteTabContentView.fxml) its height feeds
             directly into whether the "Proveedor (Entrega)" tab stays within the fixed window
             height when switching to it. -->
        <VBox spacing="10">
            <children>
                <VBox spacing="8">
                    <children>
                        <Label text="RECIBE EN REPRESENTACIÓN" styleClass="section-label"/>
                        <CheckBox fx:id="chkEnableResponsible"
                                  text="Incluir datos del responsable"
                                  styleClass="custom-checkbox-inline"/>
                    </children>
                </VBox>

                <VBox fx:id="gridResponsibleDetails" disable="true" spacing="8">
                    <children>
                        <VBox spacing="2">
                            <children>
                                <Label text="NOMBRE COMPLETO" styleClass="input-label-small"/>
                                <TextField fx:id="txtProviderResponsibleName" styleClass="form-input-main"/>
                            </children>
                        </VBox>
                        <VBox spacing="2">
                            <children>
                                <Label text="DNI" styleClass="input-label-small"/>
                                <TextField fx:id="txtProviderResponsibleDni" styleClass="form-input-main"/>
                            </children>
                        </VBox>
                        <Label fx:id="lblResponsibleStatus" text="" styleClass="input-label-small"/>
                    </children>
                </VBox>
            </children>
        </VBox>

    </children>
</VBox>
