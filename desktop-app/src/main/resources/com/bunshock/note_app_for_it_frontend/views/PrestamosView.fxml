<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="rootContainer" spacing="15" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.PrestamosController">

    <children>

        <!-- Section toggle: full width -->
        <HBox prefHeight="50.0" spacing="0">
            <children>
                <ToggleButton fx:id="btnHistory" text="HISTORIAL DE PRÉSTAMOS"
                              minWidth="0" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="type-button-left" selected="true" toggleGroup="$typeGroup">
                    <toggleGroup>
                        <ToggleGroup fx:id="typeGroup"/>
                    </toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="btnNewLoan" text="CARGAR NUEVO PRÉSTAMO INTERNO (SIN NOTA)"
                              minWidth="0" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="type-button-right" toggleGroup="$typeGroup"/>
            </children>
        </HBox>

        <StackPane fx:id="dynamicContentArea" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Cargando..." style="-fx-text-fill: #aaa;"/>
            </children>
        </StackPane>

    </children>
</VBox>
