<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="rootContainer" spacing="15" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.PrestamosController">

    <children>

        <!-- Page title — text set programmatically by PrestamosController.showHistoryTab()/
             showNewLoanTab(), called from MainController's sidebar "Préstamos" flyout, which is
             now the only way to switch between these two views. Replaces the old in-page toggle
             bar (redundant now that the sidebar flyout already offers the same choice), matching
             the same page-title-card/page-title convention every other section uses (see
             HistoryView.fxml). -->
        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <Label fx:id="lblSectionTitle" text="HISTORIAL DE PRÉSTAMOS" styleClass="page-title"/>
        </HBox>

        <StackPane fx:id="dynamicContentArea" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Cargando..." style="-fx-text-fill: #aaa;"/>
            </children>
        </StackPane>

    </children>
</VBox>
