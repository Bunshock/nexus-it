<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane style="-fx-background-color: #f4f4f4;"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bunshock.note_app_for_it_frontend.controllers.SettingsController">

    <!-- ── Panel: Configuración general ──────────────────────────────── -->
    <VBox fx:id="panelSettings" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;">
        <children>

            <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
                <Label text="CONFIGURACIÓN" styleClass="page-title"/>
            </HBox>

            <!-- A/F Format -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="FORMATO DE ACTIVO FIJO (A/F)" styleClass="section-label"/>
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>
                        <children>
                            <VBox spacing="2" GridPane.columnIndex="0">
                                <Label text="PREFIJO" styleClass="input-label-small"/>
                                <TextField fx:id="txtAfPrefix" styleClass="form-input-main"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1">
                                <Label text="SEPARADOR" styleClass="input-label-small"/>
                                <TextField fx:id="txtAfSeparator" styleClass="form-input-main"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="2">
                                <Label text="LONGITUD" styleClass="input-label-small"/>
                                <TextField fx:id="txtAfLength" styleClass="form-input-main"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="3">
                                <Label text="RELLENO" styleClass="input-label-small"/>
                                <TextField fx:id="txtAfFiller" styleClass="form-input-main"/>
                            </VBox>
                        </children>
                    </GridPane>
                    <Label fx:id="lblAfPreview" text="Vista previa: IT-00000000"
                           style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                </children>
            </VBox>

            <!-- Email (SMTP) -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="CORREO ELECTRÓNICO (SMTP)" styleClass="section-label"/>
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <children>
                            <VBox spacing="2" GridPane.columnIndex="0">
                                <Label text="DIRECCIÓN DE ENVÍO" styleClass="input-label-small"/>
                                <TextField fx:id="txtSmtpSender" styleClass="form-input-main"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1">
                                <Label text="CONTRASEÑA" styleClass="input-label-small"/>
                                <PasswordField fx:id="pfSmtpPassword" styleClass="form-input-main"/>
                            </VBox>
                        </children>
                    </GridPane>
                    <Label fx:id="lblSmtpStatus" text="" style="-fx-font-size: 11px;"/>
                </children>
            </VBox>

            <!-- GLPI -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="GLPI API" styleClass="section-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtGlpiUrl" promptText="http://glpi-server/apirest.php"
                                   HBox.hgrow="ALWAYS" styleClass="form-input-main"/>
                    </HBox>
                </children>
            </VBox>

            <!-- S/N validation -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="VALIDACIÓN DE S/N POR MODELO" styleClass="section-label"/>
                    <Label text="Expresiones regulares para validar el número de serie al agregar equipamiento. Solo editable por administrador."
                           style="-fx-text-fill: #64748b; -fx-font-size: 12px;" wrapText="true"/>
                    <HBox>
                        <Button text="Ver tabla" onAction="#onOpenSnValidation" styleClass="button-secondary"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Admin mode -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="MODO ADMINISTRADOR" styleClass="section-label"/>
                    <Label text="Habilita la sincronización GLPI en el historial y permite editar configuraciones protegidas. La sesión expira tras 15 minutos de inactividad."
                           style="-fx-text-fill: #64748b; -fx-font-size: 12px;" wrapText="true"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="btnToggleAdmin" text="Activar modo administrador"
                                onAction="#handleToggleAdmin" styleClass="button-secondary"/>
                        <Label fx:id="lblAdminStatus" text="Inactivo"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Save button -->
            <HBox alignment="CENTER_RIGHT">
                <Button text="Guardar Configuración" onAction="#handleSave" styleClass="button-primary-large"/>
            </HBox>

        </children>
    </VBox>

    <!-- ── Panel: Validación S/N por modelo ──────────────────────────── -->
    <VBox fx:id="panelSnValidation" visible="false" managed="false"
          maxWidth="Infinity" maxHeight="Infinity" spacing="15"
          style="-fx-padding: 30; -fx-background-color: #f4f4f4;">
        <children>

            <!-- Header -->
            <Label text="VALIDACIÓN DE S/N POR MODELO" styleClass="section-label"/>

            <!-- Table card -->
            <VBox spacing="10" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>

                    <!-- Filter -->
                    <TextField fx:id="txtSnFilter"
                               promptText="Filtrar por tipo, marca o modelo..."
                               styleClass="form-input-main" maxWidth="Infinity"/>

                    <!-- Table -->
                    <TableView fx:id="tblSnValidation" VBox.vgrow="ALWAYS" styleClass="modern-table, equipment-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colSnType"   text="TIPO"    prefWidth="120" minWidth="100" maxWidth="150"/>
                            <TableColumn fx:id="colSnBrand"  text="MARCA"   prefWidth="120" minWidth="100" maxWidth="150"/>
                            <TableColumn fx:id="colSnModel"  text="MODELO"  prefWidth="160" minWidth="120"/>
                            <TableColumn fx:id="colSnRegex"  text="REGEX"   prefWidth="220" minWidth="120"/>
                            <TableColumn fx:id="colSnActive" text="ACTIVO"  prefWidth="65"  minWidth="65"  maxWidth="65"  sortable="false"/>
                            <TableColumn fx:id="colSnEdit"   text=""        prefWidth="55"  minWidth="55"  maxWidth="55"  sortable="false" resizable="false"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay modelos de equipamiento configurados."/>
                        </placeholder>
                    </TableView>

                </children>
            </VBox>

            <HBox>
                <Button text="← Volver" onAction="#onBackFromSnValidation" styleClass="button-secondary"/>
            </HBox>

        </children>
    </VBox>

</StackPane>
