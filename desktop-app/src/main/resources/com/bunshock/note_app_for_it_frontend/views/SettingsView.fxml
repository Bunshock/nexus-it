<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.ToggleSwitch?>

<StackPane style="-fx-background-color: #f4f4f4;"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bunshock.note_app_for_it_frontend.controllers.admin.SettingsController">

    <!-- ── Panel: Configuración general ──────────────────────────────── -->
    <VBox fx:id="panelSettings" spacing="0" style="-fx-background-color: #f4f4f4;">
        <children>

        <!-- Fixed header (outside the ScrollPane, alongside the fixed footer below).
             Uses VBox.margin (external spacing) rather than overriding .page-title-card's own
             padding, so the card keeps its original size/look — only its position changes. -->
        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <VBox.margin>
                <Insets top="30" right="30" bottom="20" left="30"/>
            </VBox.margin>
            <Label text="CONFIGURACIÓN" styleClass="page-title"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="settings-scroll">
        <content>
        <VBox spacing="20" style="-fx-padding: 0 30 20 30; -fx-background-color: #f4f4f4;">
        <children>

            <!-- Note generation behavior — a personal preference, not admin-gated (any role can
                 change it), same as "Nombre para mostrar" in Mi Perfil. Applies immediately on
                 toggle, no separate save button, matching how a toggle switch behaves elsewhere.
                 Shown first — it's a global, always-editable user setting, unlike everything else
                 in this panel, which is an admin/superadmin-gated system configuration value. -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="GENERACIÓN DE NOTAS" styleClass="section-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                            <Label text="Limpiar el formulario automáticamente después de generar una nota"
                                   wrapText="true" style="-fx-text-fill: #334155; -fx-font-size: 12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ToggleSwitch fx:id="toggleAutoClearForm"/>
                        </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <children>
                            <Label text="Cerrar la pestaña automáticamente después de generar una nota"
                                   wrapText="true" style="-fx-text-fill: #334155; -fx-font-size: 12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ToggleSwitch fx:id="toggleAutoCloseTab"/>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- A/F Format -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="FORMATO DE ACTIVO FIJO (A/F)" styleClass="section-label"/>
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="12.5"/>
                            <ColumnConstraints percentWidth="12.5"/>
                        </columnConstraints>
                        <children>
                            <VBox spacing="2" GridPane.columnIndex="0">
                                <Label text="PREFIJO" styleClass="input-label-small"/>
                                <TextField fx:id="txtAfPrefix" styleClass="form-input-main" disable="true"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1">
                                <Label text="SEPARADOR" styleClass="input-label-small"/>
                                <TextField fx:id="txtAfSeparator" styleClass="form-input-main" disable="true"/>
                            </VBox>
                        </children>
                    </GridPane>
                    <Label fx:id="lblAfPreview" text="Vista previa: IT-AB12345678"
                           style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                </children>
            </VBox>

            <!-- S/N validation -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="VALIDACIÓN DE S/N POR MODELO" styleClass="section-label"/>
                    <Label text="Expresiones regulares para validar el número de serie al agregar equipamiento. Solo editable por administrador."
                           style="-fx-text-fill: #64748b; -fx-font-size: 12px;" wrapText="true"/>
                    <HBox>
                        <Button text="Ver tabla" onAction="#onOpenSnValidation" styleClass="button-secondary"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Email (SMTP) — moved to the very end: this panel's only SUPERADMIN-only field
                 group (EDIT_SMTP_CONFIG), everything else here is at most ADMIN-level. -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <Label text="CORREO ELECTRÓNICO (SMTP)" styleClass="section-label"/>
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>
                        <children>
                            <VBox spacing="2" GridPane.columnIndex="0">
                                <Label text="DIRECCIÓN DE ENVÍO" styleClass="input-label-small"/>
                                <TextField fx:id="txtSmtpSender" styleClass="form-input-main" disable="true"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1">
                                <Label text="CONTRASEÑA" styleClass="input-label-small"/>
                                <PasswordField fx:id="pfSmtpPassword" styleClass="form-input-main" disable="true"/>
                            </VBox>
                        </children>
                    </GridPane>
                </children>
            </VBox>

        </children>
        </VBox>
        </content>
        </ScrollPane>

            <!-- Save button (fixed footer, outside the scrollable area) -->
            <HBox spacing="15" alignment="CENTER_RIGHT"
                  style="-fx-padding: 15 30 20 30; -fx-background-color: #f4f4f4;">
                <Label fx:id="lblSaveStatus" text="" style="-fx-font-size: 11px;"/>
                <Button fx:id="btnSave" text="Guardar Configuración" onAction="#handleSave"
                        styleClass="button-primary-large"/>
            </HBox>

        </children>
    </VBox>

    <!-- ── Panel: Validación S/N por modelo ──────────────────────────── -->
    <VBox fx:id="panelSnValidation" visible="false" managed="false"
          maxWidth="Infinity" maxHeight="Infinity" spacing="15"
          style="-fx-padding: 30; -fx-background-color: #f4f4f4;">
        <children>

            <!-- Header -->
            <Label text="VALIDACIÓN DE S/N POR MODELO" styleClass="section-label"/>

            <!-- Table card -->
            <VBox spacing="10" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>

                    <!-- Filters -->
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="3">
                            <Label text="TIPO" styleClass="input-label-small"/>
                            <MenuButton fx:id="mnuSnType" text="Todas"
                                        prefWidth="160" prefHeight="32" styleClass="filter-menu-button"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="MARCA" styleClass="input-label-small"/>
                            <MenuButton fx:id="mnuSnBrand" text="Todas"
                                        prefWidth="160" prefHeight="32" styleClass="filter-menu-button"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="MODELO" styleClass="input-label-small"/>
                            <MenuButton fx:id="mnuSnModel" text="Todas"
                                        prefWidth="160" prefHeight="32" styleClass="filter-menu-button"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="ACTIVO" styleClass="input-label-small"/>
                            <MenuButton fx:id="mnuSnActive" text="Todas"
                                        prefWidth="120" prefHeight="32" styleClass="filter-menu-button"/>
                        </VBox>
                        <Button text="Limpiar filtros" onAction="#handleClearSnFilters"
                                styleClass="button-secondary" prefHeight="32"/>
                    </HBox>

                    <!-- Table -->
                    <TableView fx:id="tblSnValidation" VBox.vgrow="ALWAYS" styleClass="modern-table, equipment-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colSnType"   text="TIPO"    prefWidth="120" minWidth="100" maxWidth="150"/>
                            <TableColumn fx:id="colSnBrand"  text="MARCA"   prefWidth="120" minWidth="100" maxWidth="150"/>
                            <TableColumn fx:id="colSnModel"  text="MODELO"  prefWidth="160" minWidth="120"/>
                            <TableColumn fx:id="colSnRegex"  text="REGEX"   prefWidth="220" minWidth="120"/>
                            <TableColumn fx:id="colSnActive" text="ACTIVO"  prefWidth="65"  minWidth="65"  maxWidth="65"  sortable="false"/>
                            <TableColumn fx:id="colSnEdit"   text=""        prefWidth="55"  minWidth="55"  maxWidth="55"  sortable="false" resizable="false"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay modelos de equipamiento configurados."/>
                        </placeholder>
                    </TableView>

                </children>
            </VBox>

            <HBox>
                <Button text="← Volver" onAction="#onBackFromSnValidation" styleClass="button-secondary"/>
            </HBox>

        </children>
    </VBox>

</StackPane>
