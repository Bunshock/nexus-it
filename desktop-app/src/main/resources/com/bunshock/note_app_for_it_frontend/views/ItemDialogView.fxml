<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.geometry.Insets?>

<StackPane style="-fx-background-color: transparent; -fx-padding: 12;"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bunshock.note_app_for_it_frontend.controllers.core.ItemDialogController">

    <VBox prefWidth="520.0"
          style="-fx-background-color: #1a1a1a, white; -fx-background-radius: 12, 10; -fx-background-insets: 0, 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 5);">

        <!-- Header -->
        <HBox fx:id="hboxHeader" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to bottom right, #0e9a82, #0a6b5a); -fx-padding: 20 25; -fx-background-radius: 10 10 0 0;">
            <VBox spacing="3">
                <Label text="GESTIÓN DE EQUIPAMIENTO"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 9px; -fx-font-weight: bold; -fx-letter-spacing: 1.5;"/>
                <Label fx:id="lblDialogTitle" text="AGREGAR EQUIPAMIENTO" styleClass="dialog-title"/>
            </VBox>
        </HBox>

        <!-- Content -->
        <VBox VBox.vgrow="ALWAYS" spacing="16" style="-fx-padding: 22 25 18 25; -fx-background-color: white;">

            <!-- Type / Brand / Model cascade -->
            <GridPane hgap="12" vgap="5">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="34"/>
                </columnConstraints>
                <VBox spacing="4" GridPane.columnIndex="0">
                    <Label text="TIPO *" styleClass="input-label-small"/>
                    <ComboBox fx:id="cmbType" maxWidth="Infinity" styleClass="form-input-main"
                              style="-fx-padding: 5 8;" promptText="Seleccionar..."/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1">
                    <Label text="MARCA *" styleClass="input-label-small"/>
                    <ComboBox fx:id="cmbBrand" maxWidth="Infinity" styleClass="form-input-main"
                              style="-fx-padding: 5 8;" promptText="Seleccionar..." disable="true"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="2">
                    <Label text="MODELO *" styleClass="input-label-small"/>
                    <ComboBox fx:id="cmbModel" maxWidth="Infinity" styleClass="form-input-main"
                              style="-fx-padding: 5 8;" promptText="Seleccionar..." disable="true"/>
                </VBox>
            </GridPane>

            <Separator style="-fx-opacity: 0.35;"/>

            <!-- Asset fields -->
            <VBox fx:id="containerAssetFields" spacing="12" managed="false" visible="false">

                <!-- S/N -->
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="N° SERIE *" styleClass="input-label-small"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="chkSinSN" text="Sin S/N" onAction="#handleSinSnToggle"
                                  style="-fx-font-size: 10px; -fx-text-fill: #64748b;">
                            <tooltip><Tooltip text="Marcar solo en casos excepcionales"/></tooltip>
                        </CheckBox>
                    </HBox>
                    <TextField fx:id="txtSerial" styleClass="form-input-main" promptText="Ingrese S/N..."/>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="lblSnValidation" text="" style="-fx-font-size: 10px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="chkUppercase" text="Mayúsculas" selected="true"
                                  style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                    </HBox>
                    <TextFlow fx:id="flowSnPattern" minHeight="14"/>
                </VBox>

                <!-- A/F -->
                <VBox spacing="5">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                    <CheckBox fx:id="chkEnableAF" text="N° ACTIVO FIJO (A/F)" selected="true"
                              styleClass="input-label-small" onAction="#handleAfToggle"/>
                    <TextField fx:id="txtAF" styleClass="form-input-main"
                               promptText="Ingrese S/N para calcular A/F..." editable="false"
                               mouseTransparent="true" focusTraversable="false"/>
                </VBox>
            </VBox>

            <!-- Countable fields -->
            <VBox fx:id="containerCountableFields" spacing="5" managed="false" visible="false">
                <Label text="CANTIDAD *" styleClass="input-label-small"/>
                <TextField fx:id="txtQty" styleClass="form-input-main" text="1" prefWidth="80" maxWidth="80"/>
                <Label text="1 – 999" style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
            </VBox>

            <!-- GLPI status -->
            <HBox fx:id="hboxGlpiStatus" alignment="CENTER_LEFT" spacing="10" managed="false" visible="false">
                <ProgressIndicator fx:id="progressGlpi" prefWidth="16" prefHeight="16"
                                   maxWidth="16" maxHeight="16"/>
                <Label fx:id="lblGlpiStatus" text="" style="-fx-font-size: 11px;"/>
            </HBox>

        </VBox>

        <!-- Observations — fixed footer position, never shifts -->
        <VBox spacing="8" style="-fx-padding: 10 25 14 25; -fx-background-color: white; -fx-border-color: #e2e8f0 transparent transparent transparent; -fx-border-width: 1;">
            <Label text="OBSERVACIONES / ESTADO" styleClass="input-label-small"/>
            <TextField fx:id="txtObs" styleClass="form-input-main" promptText="Opcional..."/>
        </VBox>

        <!-- Modifica stock — own prominent row, last thing seen before Cancelar/Agregar -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 12 25; -fx-background-color: #f0fdfa; -fx-border-color: #e2e8f0 transparent #e2e8f0 transparent; -fx-border-width: 1;">
            <CheckBox fx:id="chkModifiesStock" text="Modifica stock" selected="true"
                      onAction="#handleModifiesStockToggle"
                      style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0a6b5a;">
                <tooltip><Tooltip text="Desmarcar solo en casos excepcionales — este ítem no sumará/restará stock al aprobarse la nota"/></tooltip>
            </CheckBox>
        </HBox>

        <!-- Footer -->
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0 transparent transparent transparent; -fx-border-width: 1; -fx-padding: 14 20; -fx-background-radius: 0 0 10 10;">
            <Button text="Cancelar" onAction="#onCancel" styleClass="button-secondary"/>
            <Button fx:id="btnSave" text="Agregar a la Nota" onAction="#onSave"
                    styleClass="button-primary" disable="true"/>
        </HBox>

    </VBox>
</StackPane>
