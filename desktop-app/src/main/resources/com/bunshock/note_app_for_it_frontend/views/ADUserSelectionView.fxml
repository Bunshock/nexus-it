<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="15" prefWidth="450.0" style="-fx-padding: 25; -fx-background-color: white;" 
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.ADUserSelectionController">
    
    <children>
        <Label text="COINCIDENCIAS EN AD" style="-fx-font-weight: bold; -fx-text-fill: #0c8570; -fx-font-size: 16px;"/>
        <Label text="Se encontraron múltiples usuarios. Seleccione el correcto:" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>

        <ListView fx:id="lstResults" prefHeight="250.0" styleClass="modern-table" VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <children>
                <Button fx:id="btnCancel" text="Cancelar" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #666;"/>
                <Button fx:id="btnSelect" text="Seleccionar Usuario" onAction="#handleSelection" 
                        style="-fx-background-color: #0c8570; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
            </children>
        </HBox>
    </children>
</VBox>