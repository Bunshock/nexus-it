<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox prefWidth="500.0" spacing="0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-width: 1;"
      stylesheets="/com/bunshock/note_app_for_it_frontend/css/styles.css"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.ADUserSelectionController">
    
    <children>
        <VBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="ad-header-gradient">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label text="👥" style="-fx-font-size: 24px;"/> 
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="ACTIVE DIRECTORY (AD)" styleClass="ad-header-subtitle"/>
                                <Label text="Coincidencias Encontradas" styleClass="ad-header-title"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="15" style="-fx-padding: 20;">
            <children>
                <Label text="Se han detectado múltiples usuarios en Active Directory en la búsqueda:" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                
                <ListView fx:id="lstResults" prefHeight="250.0" styleClass="ad-selection-list"/>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <children>
                        <Button fx:id="btnCancel" text="Cancelar" onAction="#handleCancel" styleClass="button-secondary"/>
                        <Button fx:id="btnSelect" text="Cargar Usuario" onAction="#handleSelection" styleClass="button-primary"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>