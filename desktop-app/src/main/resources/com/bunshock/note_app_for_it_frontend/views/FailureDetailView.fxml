<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane style="-fx-background-color: transparent; -fx-padding: 12;"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bunshock.note_app_for_it_frontend.controllers.note.FailureDetailController">

    <VBox prefWidth="440.0" spacing="0"
          style="-fx-background-color: #1a1a1a, white; -fx-background-radius: 12, 10; -fx-background-insets: 0, 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 5);">
        <children>
            <VBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="ad-header-gradient"
                  style="-fx-background-radius: 10 10 0 0;">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <children>
                            <Label text="⚠" style="-fx-font-size: 22px;"/>
                            <Label text="Detalles de Falla" styleClass="ad-header-title"/>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 0 0 10 10;">
                <children>
                    <VBox spacing="2">
                        <children>
                            <Label text="CAUSA DE LA FALLA" styleClass="input-label-small"/>
                            <ComboBox fx:id="cmbFailureCause" promptText="Seleccionar causa..."
                                      maxWidth="Infinity" styleClass="form-input-main"/>
                        </children>
                    </VBox>

                    <VBox spacing="2">
                        <children>
                            <Label text="DETALLES" styleClass="input-label-small"/>
                            <TextArea fx:id="txtFailureDetails" prefRowCount="4" wrapText="true" styleClass="form-input-main"/>
                        </children>
                    </VBox>

                    <Label fx:id="lblStatus" text="" styleClass="input-label-small"/>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <children>
                            <Button fx:id="btnCancel" text="Cancelar" onAction="#handleCancel" styleClass="button-secondary"/>
                            <Button fx:id="btnSave" text="Guardar" onAction="#handleSave" styleClass="button-primary"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</StackPane>
