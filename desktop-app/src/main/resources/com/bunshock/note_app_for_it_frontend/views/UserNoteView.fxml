<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.controlsfx.control.SearchableComboBox?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.UserNoteController">
    <children>

        <!-- User Note Type Selection -->
        <VBox spacing="0" style="-fx-padding: 0 0 5 0;">
            <children>
                <Label text="TIPO DE MOVIMIENTO" style="-fx-font-weight: bold; -fx-text-fill: #0c8570; -fx-font-size: 13px; -fx-padding: 0 0 5 0;"/>
                <HBox prefHeight="40.0" spacing="0">
                    <fx:define>
                        <ToggleGroup fx:id="typeGroup" />
                    </fx:define>
                    <children>
                        <ToggleButton fx:id="btnTypeEntrega" text="ENTREGA" selected="true"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="type-button-left" toggleGroup="$typeGroup"/>
                        <ToggleButton fx:id="btnTypeDevolucion" text="DEVOLUCIÓN" 
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="type-button-middle" toggleGroup="$typeGroup"/>
                        <ToggleButton fx:id="btnTypePrestamo" text="PRÉSTAMO" 
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="type-button-middle" toggleGroup="$typeGroup"/>
                        <ToggleButton fx:id="btnTypeFinContrato" text="FIN DE CONTRATO (ENTREGA)" 
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="type-button-right" toggleGroup="$typeGroup"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Separator style="-fx-opacity: 0.5;"/>

        <!-- User details -->
        <VBox spacing="10">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label text="DATOS DEL USUARIO" style="-fx-font-weight: bold; -fx-text-fill: #0c8570; -fx-font-size: 13px;"/>
                        <Region HBox.hgrow="ALWAYS" />

                        <Label fx:id="lblADStatus" text="" style="-fx-font-size: 11px; -fx-font-weight: bold;" />

                        <HBox spacing="8">
                            <children>
                                <Button text="Limpiar" onAction="#handleClearUserFields" styleClass="button-secondary"/>
                                <Button text="🔍 Buscar en AD" onAction="#handleADSearch" styleClass="button-primary"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="40"/>
                    </columnConstraints>
                    <children>
                        <VBox spacing="2" GridPane.columnIndex="0">
                            <Label text="DNI" styleClass="input-label-small"/>
                            <TextField fx:id="txtUserDni" styleClass="form-input-main"/>
                        </VBox>

                        <VBox spacing="2" GridPane.columnIndex="1">
                            <Label text="NOMBRE COMPLETO" styleClass="input-label-small"/>
                            <TextField fx:id="txtUserName" styleClass="form-input-main"/>
                        </VBox>

                        <VBox spacing="2" GridPane.columnIndex="2">
                            <Label text="USERNAME" styleClass="input-label-small"/>
                            <TextField fx:id="txtUserAccount" styleClass="form-input-main"/>
                            <Label fx:id="lblUserEmail" text="email: " 
                                style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-style: italic;"/>
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </VBox>

       <Separator style="-fx-opacity: 0.5;"/>

        <!-- Equipment detail tables -->
       <VBox spacing="15" VBox.vgrow="ALWAYS">
            <children>
                <Label text="DETALLES DEL EQUIPAMIENTO" style="-fx-font-weight: bold; -fx-text-fill: #0c8570; -fx-font-size: 13px;"/>

                <!-- Equipment details - Asset -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Equipos con S/N (Notebooks, Monitores, etc.)" styleClass="table-section-caption"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="+ Agregar" onAction="#handleAddItem" styleClass="button-primary"/>
                        </HBox>
                        <TableView fx:id="tblAssets" styleClass="modern-table" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colAssetType" text="TIPO" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colAssetBrand" text="MARCA" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colAssetModel" text="MODELO" prefWidth="150" minWidth="150" maxWidth="150"/>
                                <TableColumn fx:id="colAssetSerial" text="S/N" prefWidth="150" minWidth="150" maxWidth="150"/>
                                <TableColumn fx:id="colAssetAF" text="A/F" prefWidth="80" minWidth="80" maxWidth="80"/>
                                <TableColumn fx:id="colAssetObs" text="OBSERVACIONES" />
                                <TableColumn fx:id="colAssetActions" text="ACCIONES" prefWidth="80" minWidth="80" maxWidth="80"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- Equipment details - Countable -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Periféricos y otros (Por Cantidad)" styleClass="table-section-caption"/>
                        <TableView fx:id="tblCountables" styleClass="modern-table" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colCountType" text="TIPO" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colCountBrand" text="MARCA" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colCountModel" text="MODELO" prefWidth="150" minWidth="150" maxWidth="150"/>
                                <TableColumn fx:id="colCountQty" text="CANT." prefWidth="60" minWidth="60" maxWidth="60"/>
                                <TableColumn fx:id="colCountObs" text="OBSERVACIONES" />
                                <TableColumn fx:id="colCountActions" text="ACCIONES" prefWidth="80" minWidth="80" maxWidth="80"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
        
    </children>
</VBox>