<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>

<VBox spacing="14" maxHeight="Infinity"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.UserNoteController">
    <children>

        <!-- Motivo: note type is now selected externally, at the NoteGeneratorView level
             (cmbNoteType), pushed in via UserNoteController.setNoteType(). -->
        <VBox fx:id="vboxMotivo" spacing="4" managed="false" visible="false">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <children>
                        <Label text="MOTIVO" styleClass="input-label-small"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFailureSummary" text="⚙ Editar" styleClass="input-label-small"
                               managed="false" visible="false" onMouseClicked="#handleEditFailureDetails"
                               style="-fx-text-fill: #0c8570; -fx-cursor: hand;"/>
                        <Label fx:id="lblMotivoStatus" text="" styleClass="input-label-small"/>
                    </children>
                </HBox>
                <ComboBox fx:id="cmbMotivo" promptText="Seleccionar motivo..."
                          maxWidth="Infinity" styleClass="form-input-main"/>
            </children>
        </VBox>

        <!-- Fecha tentativa de devolución: shown only for Préstamo -->
        <VBox fx:id="vboxFechaTentativa" spacing="4" managed="false" visible="false">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="FECHA TENTATIVA DE DEVOLUCIÓN" styleClass="input-label-small"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFechaTentativaStatus" text="" styleClass="input-label-small"/>
                    </children>
                </HBox>
                <DatePicker fx:id="dtpFechaTentativa" maxWidth="Infinity" styleClass="form-input-main"/>
            </children>
        </VBox>

        <Separator style="-fx-opacity: 0.5;">
            <VBox.margin><Insets top="4" bottom="4"/></VBox.margin>
        </Separator>

        <!-- User details header + action buttons -->
        <VBox spacing="8">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <Label text="DATOS DEL USUARIO" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblADStatus" text="" style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    </children>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 2 0 6 0;">
                    <children>
                        <Button fx:id="btnBuscarAD" text="Buscar en AD" onAction="#handleADSearch" styleClass="button-primary"/>
                        <ProgressIndicator fx:id="spinnerADSearch" visible="false" managed="false"
                                           minWidth="16" minHeight="16" maxWidth="16" maxHeight="16"
                                           style="-fx-progress-color: #0c8570;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Limpiar" onAction="#handleClearUserFields" styleClass="button-secondary"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Nombre completo -->
        <VBox spacing="2">
            <children>
                <Label text="NOMBRE COMPLETO" styleClass="input-label-small"/>
                <TextField fx:id="txtUserName" styleClass="form-input-main" onAction="#handleADSearch"/>
            </children>
        </VBox>

        <!-- DNI -->
        <VBox spacing="2">
            <children>
                <Label text="DNI" styleClass="input-label-small"/>
                <TextField fx:id="txtUserDni" styleClass="form-input-main" onAction="#handleADSearch"/>
            </children>
        </VBox>

        <!-- Username + email -->
        <VBox spacing="2">
            <children>
                <Label text="USERNAME" styleClass="input-label-small"/>
                <TextField fx:id="txtUserAccount" styleClass="form-input-main" onAction="#handleADSearch"/>
                <Label fx:id="lblUserEmail" text="email: "
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-style: italic; -fx-padding: 0 0 0 5;"/>
            </children>
        </VBox>

        <!-- Área / Evento: shown only for Préstamo. Placed at the very bottom (below Datos del
             Usuario) rather than alongside Fecha Tentativa, so switching to Préstamo doesn't
             shift the Datos del Usuario section's position — only content below it grows. -->
        <VBox fx:id="vboxAreaEvento" spacing="2" managed="false" visible="false">
            <children>
                <Label text="ÁREA / EVENTO (OPCIONAL)" styleClass="input-label-small"/>
                <TextField fx:id="txtAreaEvento" maxWidth="Infinity" styleClass="form-input-main"
                           promptText="Ej: Área de Sistemas, Capacitación anual..."/>
            </children>
        </VBox>

    </children>
</VBox>
