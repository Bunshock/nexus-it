<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="rootContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.DatabaseSectionController">
    <children>

        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <Label text="BASE DE DATOS" styleClass="page-title"/>
        </HBox>

        <!-- DB connection config -->
        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="CONEXIÓN" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✏ Editar" onAction="#handleEditConnection" styleClass="button-secondary"/>
                    <Button text="Probar conexión" onAction="#handleTestConnection" styleClass="button-primary"/>
                </HBox>
                <GridPane hgap="14" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="SERVIDOR" styleClass="input-label-small"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDbServer" text="No configurado"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="BASE DE DATOS" styleClass="input-label-small"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDbName" text="—"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="ESTADO REMOTO" styleClass="input-label-small"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblConnectionStatus" text="Sin verificar"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="ESTADO LOCAL" styleClass="input-label-small"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="lblLocalConnectionStatus" text="Sin verificar"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </children>
        </VBox>

        <!-- Title + Stock Sede context, inline in one header row (Providers/Sedes were removed
             from Base de Datos — edited via direct SQL now, see CLAUDE.md). The combo is hidden
             (visible=false only, still managed — see DatabaseSectionController.initStockSedeSelector())
             for a plain ADMIN/USER, so its layout space stays reserved and the row's height
             always matches the SUPERADMIN case, which shows every Sede plus a leading "Todas"
             (combined/summed) entry, selectable. -->
        <HBox styleClass="page-subtitle-card" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="lblEquipmentCatalogTitle" styleClass="page-subtitle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbStockSede" prefWidth="220" styleClass="form-input-main, sede-combo"/>
            </children>
        </HBox>

        <!-- Equipment catalog: Types/Brands/Models cascade -->
        <HBox spacing="15" VBox.vgrow="ALWAYS">

            <!-- Types -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TIPOS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddType" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listTypes" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditType" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveType" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Brands -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MARCAS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddBrand" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listBrands" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditBrand" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveBrand" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Models -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MODELOS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddModel" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listModels" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditModel" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Stock" onAction="#handleModifyStock" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveModel" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

        </HBox>

    </children>
</VBox>
