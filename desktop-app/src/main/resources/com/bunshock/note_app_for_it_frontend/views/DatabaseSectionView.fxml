<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.admin.DatabaseSectionController">
    <children>

        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <Label text="BASE DE DATOS" styleClass="page-title"/>
        </HBox>

        <!-- Title + Stock Sede context, inline in one header row (Providers/Sedes were removed
             from Base de Datos — edited via direct SQL now, see CLAUDE.md). The combo is hidden
             (visible=false only, still managed — see DatabaseSectionController.initStockSedeSelector())
             for a plain ADMIN/USER, so its layout space stays reserved and the row's height
             always matches the SUPERADMIN case, which shows every Sede plus a leading "Todas"
             (combined/summed) entry, selectable. -->
        <HBox styleClass="page-subtitle-card" alignment="CENTER_LEFT">
            <children>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <children>
                        <Label text="CATÁLOGO DE EQUIPOS :" styleClass="page-subtitle"/>
                        <Label fx:id="lblEquipmentCatalogSede" styleClass="page-subtitle-sede"/>
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRefreshCatalog" text="↻ Actualizar datos" onAction="#handleRefreshCatalog"
                        styleClass="button-refresh-catalog">
                    <HBox.margin><Insets right="10"/></HBox.margin>
                </Button>
                <ComboBox fx:id="cmbStockSede" prefWidth="220" styleClass="form-input-main, sede-combo"/>
            </children>
        </HBox>

        <!-- Equipment catalog: Types/Brands/Models cascade -->
        <HBox spacing="15" VBox.vgrow="ALWAYS">

            <!-- Types -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TIPOS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAddType" text="+ Agregar" onAction="#handleAddType" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listTypes" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button fx:id="btnEditType" text="Editar" onAction="#handleEditType" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRemoveType" text="Eliminar" onAction="#handleRemoveType" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Brands -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MARCAS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAddBrand" text="+ Agregar" onAction="#handleAddBrand" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listBrands" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button fx:id="btnEditBrand" text="Editar" onAction="#handleEditBrand" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRemoveBrand" text="Eliminar" onAction="#handleRemoveBrand" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Models -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MODELOS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAddModel" text="+ Agregar" onAction="#handleAddModel" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listModels" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button fx:id="btnEditModel" text="Editar" onAction="#handleEditModel" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnModifyStock" text="Stock" onAction="#handleModifyStock" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRemoveModel" text="Eliminar" onAction="#handleRemoveModel" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

        </HBox>

    </children>
</VBox>
