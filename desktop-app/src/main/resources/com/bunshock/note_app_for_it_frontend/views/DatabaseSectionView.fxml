<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="rootContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.DatabaseSectionController">
    <children>

        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <Label text="BASE DE DATOS" styleClass="page-title"/>
        </HBox>

        <!-- DB connection config -->
        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="CONEXIÓN" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✏ Editar" onAction="#handleEditConnection" styleClass="button-secondary"/>
                    <Button text="Probar conexión" onAction="#handleTestConnection" styleClass="button-primary"/>
                </HBox>
                <GridPane hgap="14" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="SERVIDOR" styleClass="input-label-small"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDbServer" text="No configurado"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="BASE DE DATOS" styleClass="input-label-small"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDbName" text="—"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="ESTADO REMOTO" styleClass="input-label-small"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblConnectionStatus" text="Sin verificar"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="ESTADO LOCAL" styleClass="input-label-small"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="lblLocalConnectionStatus" text="Sin verificar"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </children>
        </VBox>

        <!-- Catalog group toggle: Types/Brands/Models cascade vs. flat/independent catalogs -->
        <HBox prefHeight="46.0" spacing="0">
            <children>
                <ToggleButton fx:id="btnEquipmentCatalog" text="CATÁLOGO DE EQUIPOS"
                              minWidth="0" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="type-button-left" selected="true" toggleGroup="$catalogGroup">
                    <toggleGroup>
                        <ToggleGroup fx:id="catalogGroup"/>
                    </toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="btnOtherCatalogs" text="OTROS CATÁLOGOS"
                              minWidth="0" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                              styleClass="type-button-right" toggleGroup="$catalogGroup"/>
            </children>
        </HBox>

        <!-- Equipment catalog: Types/Brands/Models cascade -->
        <HBox fx:id="rowEquipmentCatalog" spacing="15" VBox.vgrow="ALWAYS">

            <!-- Types -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TIPOS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddType" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listTypes" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditType" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveType" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Brands -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MARCAS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddBrand" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listBrands" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditBrand" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveBrand" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Models -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MODELOS" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddModel" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listModels" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditModel" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Stock" onAction="#handleModifyStock" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveModel" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

        </HBox>

        <!-- Other catalogs: flat, independent lists (no cascade between them) -->
        <HBox fx:id="rowOtherCatalogs" spacing="15" VBox.vgrow="ALWAYS" visible="false" managed="false">

            <!-- Providers -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="PROVEEDORES" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddProvider" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listProviders" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditProvider" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveProvider" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

            <!-- Sedes -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15 20 20 20;">
                <children>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="SEDES" styleClass="section-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Agregar" onAction="#handleAddSede" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="listSedes" VBox.vgrow="ALWAYS" styleClass="modern-list"/>
                    <HBox spacing="8">
                        <Button text="Editar" onAction="#handleEditSede" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Eliminar" onAction="#handleRemoveSede" styleClass="button-secondary"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </children>
            </VBox>

        </HBox>

    </children>
</VBox>
