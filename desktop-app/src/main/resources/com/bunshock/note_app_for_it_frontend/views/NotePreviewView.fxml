<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.WebView?>

<VBox fx:id="rootContainer" spacing="0" prefWidth="1100" prefHeight="720"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.note.NotePreviewController">
    <children>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to bottom right, #0e9a82, #0a6b5a);
                     -fx-padding: 20 25;
                     -fx-background-radius: 10 10 0 0;">
            <VBox spacing="3">
                <Label text="HERRAMIENTA DE GENERACIÓN"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 9px;
                              -fx-font-weight: bold; -fx-letter-spacing: 1.5;"/>
                <Label text="GENERAR REPORTE" styleClass="dialog-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#handleCancel" styleClass="dialog-header-close-button"/>
        </HBox>

        <!-- Content row: note preview (left) + options panel (right) -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">
            <children>

                <WebView fx:id="webPreview" HBox.hgrow="ALWAYS" minWidth="700"
                         style="-fx-background-color: white;"/>

                <VBox spacing="18" prefWidth="290"
                      style="-fx-padding: 28 26 26 26;
                             -fx-background-color: #f8fafc;
                             -fx-border-color: #e2e8f0;
                             -fx-border-width: 0 0 0 1;
                             -fx-background-radius: 0 0 10 0;">
                    <children>

                        <Label text="OPCIONES DE GENERACIÓN"
                               style="-fx-font-weight: bold; -fx-font-size: 11px;
                                      -fx-text-fill: #64748b; -fx-letter-spacing: 1px;"/>

                        <Separator/>

                        <!-- Print -->
                        <CheckBox fx:id="chkPrint" text="Imprimir nota" selected="true"
                                  style="-fx-font-size: 13px; -fx-text-fill: #1e293b;"/>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Label fx:id="lblStatus" text="" wrapText="true"
                               style="-fx-font-size: 11px;"/>

                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="Cancelar" onAction="#handleCancel" styleClass="button-secondary-medium"/>
                            <Button fx:id="btnGenerate" text="Generar" onAction="#handleGenerate"
                                    styleClass="button-primary-large" disable="true"/>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</VBox>
