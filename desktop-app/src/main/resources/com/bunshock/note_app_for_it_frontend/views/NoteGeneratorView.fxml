<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox fx:id="rootContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.note.NoteGeneratorController">

    <children>

        <!-- Page header, matching Base de Datos/Configuración's own page-title-card pattern. -->
        <HBox styleClass="page-title-card" alignment="CENTER_LEFT">
            <children>
                <Label text="GENERAR NOTA" styleClass="page-title"/>
            </children>
        </HBox>

        <!-- pageStack: active page's content. tabBarRow: Excel-style page-tab strip + shared
             action buttons. The wrapper HBox and pageTabsBox are TOP_LEFT, not CENTER_LEFT — both
             get stretched to tabBarRow's 52px minHeight (HBox's default fillHeight), so
             CENTER_LEFT was centering the tabs ~10px below the frame; pixel-verified flush now. -->
        <VBox spacing="0" VBox.vgrow="ALWAYS">
            <children>
                <StackPane fx:id="pageStack" VBox.vgrow="ALWAYS"/>

                <HBox fx:id="tabBarRow" spacing="8" minHeight="52">
                    <children>
                        <HBox alignment="TOP_LEFT" spacing="16">
                            <children>
                                <HBox fx:id="pageTabsBox" spacing="4" alignment="TOP_LEFT" translateX="14"/>
                                <Button fx:id="btnAddTab" text="+" styleClass="page-tab-add-button"/>
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" translateY="8">
                            <children>
                                <Label fx:id="lblGenerationStatus" text="" opacity="0"
                                       style="-fx-text-fill: #22c55e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <Button text="Limpiar Formulario" onAction="#handleClearForm" styleClass="button-secondary-large"/>
                                <Button text="Generar Nota" onAction="#handleGenerateNote" styleClass="button-primary-large"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
