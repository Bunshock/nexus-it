<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="15" style="-fx-padding: 30; -fx-background-color: #f4f4f4;" 
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bunshock.note_app_for_it_frontend.controllers.NoteGeneratorController">
    
    <!-- Note Target Type Selection -->
    <children>
        <HBox prefHeight="50.0" spacing="0">
            <children>
                <ToggleButton fx:id="btnUserNote" text="NOTA PARA USUARIO" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="entity-button-left" selected="true" toggleGroup="$entityGroup">
                    <toggleGroup>
                        <ToggleGroup fx:id="entityGroup"/>
                    </toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="btnProviderNote" text="NOTA PARA PROVEEDOR" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="entity-button-right" toggleGroup="$entityGroup"/>
            </children>
        </HBox>

        <!-- Note content -->
        <StackPane fx:id="dynamicContentArea" VBox.vgrow="ALWAYS" minHeight="230.0" prefHeight="230.0"
                style="-fx-background-color: white; -fx-background-radius: 10 10 0 0; -fx-padding: 20;">
            <children>
                <Label text="Seleccione un perfil arriba para cargar el formulario." style="-fx-text-fill: #aaa;"/>
            </children>
        </StackPane>

        <!-- Equipment detail tables -->
       <VBox spacing="15" VBox.vgrow="ALWAYS"
                style="-fx-background-color: white; -fx-background-radius: 0 0 10 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="DETALLES DEL EQUIPAMIENTO" style="-fx-font-weight: bold; -fx-text-fill: #0c8570; -fx-font-size: 13px;"/>

                <!-- Equipment details - Asset -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Equipos con S/N (Notebooks, Monitores, etc.)" styleClass="table-section-caption"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="+ Agregar" onAction="#handleAddItem" styleClass="button-primary"/>
                        </HBox>
                        <TableView fx:id="tblAssets" styleClass="modern-table" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No hay ítems cargados. Haga click en '+ Agregar'." />
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colAssetType" text="TIPO" prefWidth="120" minWidth="120" maxWidth="120"/>
                                <TableColumn fx:id="colAssetBrand" text="MARCA" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colAssetModel" text="MODELO" prefWidth="180" minWidth="180" maxWidth="180"/>
                                <TableColumn fx:id="colAssetSerial" text="S/N" prefWidth="150" minWidth="150" maxWidth="150"/>
                                <TableColumn fx:id="colAssetAF" text="A/F" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colAssetObs" text="OBSERVACIONES" />
                                <TableColumn fx:id="colAssetActions" text="ACCIONES" prefWidth="80" minWidth="80" maxWidth="80"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- Equipment details - Countable -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Periféricos y otros (Por Cantidad)" styleClass="table-section-caption"/>
                        <TableView fx:id="tblCountables" styleClass="modern-table" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="No hay ítems cargados. Haga click en '+ Agregar'." />
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colCountType" text="TIPO" prefWidth="120" minWidth="120" maxWidth="120"/>
                                <TableColumn fx:id="colCountBrand" text="MARCA" prefWidth="100" minWidth="100" maxWidth="100"/>
                                <TableColumn fx:id="colCountModel" text="MODELO" prefWidth="180" minWidth="180" maxWidth="180"/>
                                <TableColumn fx:id="colCountQty" text="CANT." prefWidth="60" minWidth="60" maxWidth="60"/>
                                <TableColumn fx:id="colCountObs" text="OBSERVACIONES" />
                                <TableColumn fx:id="colCountActions" text="ACCIONES" prefWidth="80" minWidth="80" maxWidth="80" sortable="false" resizable="false"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- General Observations -->
        <VBox spacing="5" minHeight="110.0" prefHeight="110.0" maxHeight="110.0"
                style="-fx-background-color: white; -fx-background-radius: 10 10 10 10; -fx-padding: 15 20 20 20;">
            <children>
                <Label text="OBSERVACIONES GENERALES" style="-fx-font-weight: bold; -fx-text-fill: #0c8570; -fx-font-size: 13px;"/>
                <TextField fx:id="txtObservations" 
                        prefHeight="35.0" 
                        promptText="Ingrese detalles adicionales aquí..." 
                        styleClass="modern-text-field-small"
                        style="-fx-alignment: CENTER_LEFT;"/>
            </children>
        </VBox>
        
        <!-- Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <children>
                <Button text="Limpiar Formulario" onAction="#handleClearForm" styleClass="button-secondary-large"/>
                <Button text="Generar PDF y Registrar" onAction="#handleGenerateNote" styleClass="button-primary-large"/>
            </children>
        </HBox>
    </children>
</VBox>