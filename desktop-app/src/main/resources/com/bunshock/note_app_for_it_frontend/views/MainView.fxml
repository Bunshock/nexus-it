<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="rootPane" prefHeight="850" prefWidth="1275.0" styleClass="app-window-frame"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bunshock.note_app_for_it_frontend.controllers.MainController"
            stylesheets="/com/bunshock/note_app_for_it_frontend/css/styles.css">
   <fx:define>
      <ToggleGroup fx:id="navigationGroup" />
   </fx:define>

   <top>
      <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="36" maxWidth="Infinity" styleClass="app-title-bar">
         <children>
            <ImageView fitWidth="17" fitHeight="17" preserveRatio="true">
               <image>
                  <Image url="/com/bunshock/note_app_for_it_frontend/images/favicon.png" />
               </image>
            </ImageView>
            <Label text="Universidad Siglo 21 - Soporte IT - Registro de Movimientos y Generación de Notas"
                   styleClass="app-title-bar-label"/>
            <Label fx:id="lblAdminIndicator" text="MODO ADMINISTRADOR"
                   visible="false" managed="false" styleClass="title-bar-admin-badge">
               <HBox.margin><Insets left="10"/></HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnLogout" text="Cerrar sesión" onAction="#handleLogout" styleClass="title-bar-logout-button">
               <HBox.margin><Insets right="10"/></HBox.margin>
            </Button>
            <Button fx:id="btnMinimizeWindow" text="─" onAction="#handleMinimizeWindow" styleClass="title-bar-button"/>
            <Button fx:id="btnMaximizeRestoreWindow" onAction="#handleMaximizeRestoreWindow" styleClass="title-bar-button"/>
            <Button fx:id="btnCloseWindow" text="✕" onAction="#handleCloseWindow" styleClass="title-bar-button,title-bar-button-close"/>
         </children>
         <padding>
            <Insets left="12" right="0"/>
         </padding>
      </HBox>
   </top>

   <left>
      <VBox styleClass="sidebar" prefWidth="235">
         <children>
            
            <!-- Logo -->
            <StackPane style="-fx-padding: 0 0 0 0;"> 
               <children>
                  <StackPane styleClass="logo-frame">
                     <children>
                        <ImageView fx:id="imgLogo" fitWidth="180" preserveRatio="true">
                           <image>
                              <Image url="/com/bunshock/note_app_for_it_frontend/images/logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
               </children>
            </StackPane>

            <!-- Title -->
            <VBox alignment="CENTER_LEFT" spacing="2" style="-fx-padding: 0 0 2 0;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Region prefWidth="4" prefHeight="25" style="-fx-background-color: #4db6ac; -fx-background-radius: 2;"/>
                           <Label text="MOVIMIENTOS" styleClass="sidebar-title-main"/>
                        </children>
                  </HBox>
                  <Label text="SOPORTE IT - SITA - UES21" styleClass="sidebar-title-sub" style="-fx-padding: 0 0 0 14;"/>
                  <Region prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.1); -fx-min-height: 1; -fx-translate-y: 4;"/>
               </children>
            </VBox>

            <!-- Spacers above and below the welcome block are equal (both VBox.vgrow="ALWAYS"),
                 so the welcome/username block sits vertically centered between the header
                 separator and the nav buttons. -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- User info and welcome message. lblSede uses its own smaller .user-sede class
                 (not .user-username) plus a small top margin, so it reads as a separate line
                 from Hola/Usuario without adding as much height as reusing the bigger class
                 would — keeps the block close to its pre-Sede footprint so showing/hiding it
                 doesn't visibly shift the nav buttons below. -->
            <VBox spacing="2" style="-fx-padding: 0 0 0 5;">
               <children>
                  <Label fx:id="lblWelcome" styleClass="user-welcome"/>
                  <HBox alignment="CENTER_LEFT" spacing="4">
                     <children>
                        <Label fx:id="lblUsernameWarningIcon" text="⚠" styleClass="username-warning-icon"
                               visible="false" managed="false"/>
                        <Label fx:id="lblUsername" styleClass="user-username"/>
                     </children>
                  </HBox>
                  <Label fx:id="lblSede" styleClass="user-sede" visible="false" managed="false">
                     <VBox.margin><Insets top="4"/></VBox.margin>
                  </Label>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Main navigation buttons -->
            <ToggleButton text="Generar Nota" fx:id="btnGenerator" toggleGroup="$navigationGroup"
                  maxWidth="Infinity" styleClass="nav-button" selected="true" onAction="#handleShowGenerator"/>
            <StackPane maxWidth="Infinity">
               <children>
                  <ToggleButton text="Historial" fx:id="btnHistory" toggleGroup="$navigationGroup"
                        maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowHistory"/>
                  <HBox spacing="6" alignment="CENTER_RIGHT" mouseTransparent="true"
                        StackPane.alignment="CENTER_RIGHT">
                     <StackPane.margin><Insets right="15"/></StackPane.margin>
                     <children>
                        <Label fx:id="lblApprovalBadge" text="" styleClass="nav-badge, nav-badge-approval"
                               visible="false" managed="false"/>
                        <Label fx:id="lblHistoryBadge" text="" styleClass="nav-badge"
                               visible="false" managed="false"/>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <StackPane maxWidth="Infinity">
               <children>
                  <ToggleButton text="Préstamos" fx:id="btnPrestamos" toggleGroup="$navigationGroup"
                        maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowPrestamos"/>
                  <HBox spacing="6" alignment="CENTER_RIGHT" mouseTransparent="true"
                        StackPane.alignment="CENTER_RIGHT">
                     <StackPane.margin><Insets right="15"/></StackPane.margin>
                     <children>
                        <Label fx:id="lblPrestamosApprovalBadge" text="" styleClass="nav-badge, nav-badge-approval"
                               visible="false" managed="false"/>
                        <Label fx:id="lblPrestamosBadge" text="" styleClass="nav-badge"
                               visible="false" managed="false"/>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <ToggleButton text="Base de Datos" fx:id="btnData" toggleGroup="$navigationGroup"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowDatabase"/>

            <!-- Separator -->
            <Region maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-min-height: 1; -fx-max-height: 1;">
               <VBox.margin><Insets left="12" right="12" top="4" bottom="4"/></VBox.margin>
            </Region>

            <!-- Secondary navigation buttons -->
            <ToggleButton text="Mi Perfil" fx:id="btnProfile" toggleGroup="$navigationGroup"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowProfile"/>
            <ToggleButton text="Configuración" fx:id="btnSettings" toggleGroup="$navigationGroup"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowSettings"/>
            <ToggleButton text="Acerca de" fx:id="btnAbout" toggleGroup="$navigationGroup"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowAbout"/>

            <!-- Server status -->
            <VBox spacing="8" style="-fx-padding: 15 0 0 0;">
               <children>
                  <Label text="ESTADO DE SERVICIOS" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 9px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                  <!-- Active Directory -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <Circle fx:id="circleAD" radius="5.0" fill="#ff9800" stroke="#ffffff" strokeWidth="1.0" />
                        <Label text="Active Directory (AD) API" style="-fx-text-fill: white; -fx-font-size: 11px;">
                              <tooltip>
                                 <Tooltip fx:id="tooltipAD" text="Verificando estado..." />
                              </tooltip>
                        </Label>
                     </children>
                  </HBox>
                  <!-- GLPI API -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Circle fx:id="circleGLPI" radius="5.0" fill="#f44336" stroke="#ffffff" strokeWidth="1.0" />
                           <Label text="GLPI API" style="-fx-text-fill: white; -fx-font-size: 11px;">
                              <tooltip>
                                 <Tooltip fx:id="tooltipGLPI" text="Verificando estado..." />
                              </tooltip>
                           </Label>
                        </children>
                  </HBox>
                  <!-- Remote DB -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Circle fx:id="circleDB" radius="5.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0" />
                           <Label text="Base de Datos" style="-fx-text-fill: white; -fx-font-size: 11px;">
                              <tooltip>
                                 <Tooltip fx:id="tooltipDB" text="Verificando estado..." />
                              </tooltip>
                           </Label>
                        </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </left>
   
   <center>
      <StackPane fx:id="contentArea">
         <Label text="Seleccione una opción de la barra lateral para comenzar." />
      </StackPane>
   </center>
</BorderPane>