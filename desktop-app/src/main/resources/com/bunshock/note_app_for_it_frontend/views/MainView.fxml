<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="rootPane" prefHeight="850" prefWidth="1275.0" styleClass="app-window-frame"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bunshock.note_app_for_it_frontend.controllers.core.MainController"
            stylesheets="/com/bunshock/note_app_for_it_frontend/css/styles.css">
   <fx:define>
      <ToggleGroup fx:id="flyoutMovimientosGroup" />
      <ToggleGroup fx:id="flyoutPrestamosGroup" />
      <ToggleGroup fx:id="flyoutEnviosGroup" />
   </fx:define>

   <top>
      <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="36" maxWidth="Infinity" styleClass="app-title-bar">
         <children>
            <ImageView fitWidth="17" fitHeight="17" preserveRatio="true">
               <image>
                  <Image url="/com/bunshock/note_app_for_it_frontend/images/favicon.png" />
               </image>
            </ImageView>
            <Label text="Universidad Siglo 21 - Soporte IT - Registro de Movimientos y Generación de Notas"
                   styleClass="app-title-bar-label"/>
            <Label fx:id="lblAdminIndicator" text="MODO ADMINISTRADOR"
                   visible="false" managed="false" styleClass="title-bar-admin-badge">
               <HBox.margin><Insets left="10"/></HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Compact status preview: mirrors circleMiddleware/circleDirectory/circleDb's colors
                 (kept in sync by MainController.applyStatusSnapshot()). Hovering opens the full
                 "ESTADO DE SERVICIOS" panel (statusPanel below, reparented into a PopOver at
                 runtime by MainController.setupTitleBarStatusHover()). -->
            <HBox fx:id="statusPreview" spacing="6" alignment="CENTER" style="-fx-cursor: hand;">
               <HBox.margin><Insets right="14"/></HBox.margin>
               <children>
                  <Circle fx:id="circleMiddlewareMini" radius="4.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0"/>
                  <Circle fx:id="circleDirectoryMini" radius="4.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0"/>
                  <Circle fx:id="circleDbMini" radius="4.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0"/>
               </children>
            </HBox>
            <Button fx:id="btnLogout" text="Cerrar sesión" onAction="#handleLogout" styleClass="title-bar-logout-button">
               <HBox.margin><Insets right="10"/></HBox.margin>
            </Button>
            <Button fx:id="btnMinimizeWindow" text="─" onAction="#handleMinimizeWindow" styleClass="title-bar-button"/>
            <Button fx:id="btnMaximizeRestoreWindow" onAction="#handleMaximizeRestoreWindow" styleClass="title-bar-button"/>
            <Button fx:id="btnCloseWindow" text="✕" onAction="#handleCloseWindow" styleClass="title-bar-button,title-bar-button-close"/>
         </children>
         <padding>
            <Insets left="12" right="0"/>
         </padding>
      </HBox>
   </top>

   <left>
      <VBox styleClass="sidebar" prefWidth="235">
         <children>
            
            <!-- Logo -->
            <StackPane style="-fx-padding: 0 0 0 0;"> 
               <children>
                  <StackPane styleClass="logo-frame">
                     <children>
                        <ImageView fx:id="imgLogo" fitWidth="180" preserveRatio="true">
                           <image>
                              <Image url="/com/bunshock/note_app_for_it_frontend/images/logo.jpg" />
                           </image>
                        </ImageView>
                     </children>
                  </StackPane>
               </children>
            </StackPane>

            <!-- Title -->
            <VBox alignment="CENTER_LEFT" spacing="2" style="-fx-padding: 0 0 2 0;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Region prefWidth="4" prefHeight="25" style="-fx-background-color: #4db6ac; -fx-background-radius: 2;"/>
                           <Label text="Nexus IT" styleClass="sidebar-title-main"/>
                        </children>
                  </HBox>
                  <Label text="SOPORTE IT - SITA - UES21" styleClass="sidebar-title-sub" style="-fx-padding: 0 0 0 14;"/>
                  <Region prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.1); -fx-min-height: 1; -fx-translate-y: 4;"/>
               </children>
            </VBox>

            <!-- Spacers above and below the welcome block are equal (both VBox.vgrow="ALWAYS"),
                 so the welcome/username block sits vertically centered between the header
                 separator and the nav buttons. -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- User info and welcome message. lblSede uses its own smaller .user-sede class
                 (not .user-username) plus a small top margin, so it reads as a separate line
                 from Hola/Usuario without adding as much height as reusing the bigger class
                 would — keeps the block close to its pre-Sede footprint so showing/hiding it
                 doesn't visibly shift the nav buttons below. -->
            <VBox spacing="2" style="-fx-padding: 0 0 0 5;">
               <children>
                  <Label fx:id="lblWelcome" styleClass="user-welcome"/>
                  <HBox alignment="CENTER_LEFT" spacing="4">
                     <children>
                        <Label fx:id="lblUsernameWarningIcon" text="⚠" styleClass="username-warning-icon"
                               visible="false" managed="false"/>
                        <Label fx:id="lblUsername" styleClass="user-username"/>
                     </children>
                  </HBox>
                  <Label fx:id="lblSede" styleClass="user-sede" visible="false" managed="false">
                     <VBox.margin><Insets top="4"/></VBox.margin>
                  </Label>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Sidebar nav: "Movimientos" (Generar Nota/Historial) and "Préstamos" (Cargar
                 Préstamo Interno/Historial de Préstamos) each open a flyout to the right on
                 click. The flyoutMovimientos/flyoutPrestamos VBoxes below start visible/
                 managed=false so they don't render inline; MainController.setupNavFlyouts()
                 moves each into its own Popup and flips both flags back to true. -->
            <Button text="Movimientos" fx:id="btnMovimientosGroup"
                  maxWidth="Infinity" styleClass="nav-button"
                  onAction="#handleToggleMovimientosFlyout"/>
            <VBox fx:id="flyoutMovimientos" visible="false" managed="false" spacing="4" prefWidth="235" styleClass="nav-flyout">
               <children>
                  <ToggleButton text="Generar Nota" fx:id="btnGenerator" toggleGroup="$flyoutMovimientosGroup"
                        maxWidth="Infinity" styleClass="nav-button" selected="true" onAction="#handleShowGenerator"/>
                  <StackPane maxWidth="Infinity">
                     <children>
                        <ToggleButton text="Historial" fx:id="btnHistory" toggleGroup="$flyoutMovimientosGroup"
                              maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowHistory"/>
                        <HBox spacing="6" alignment="CENTER_RIGHT" mouseTransparent="true"
                              StackPane.alignment="CENTER_RIGHT">
                           <StackPane.margin><Insets right="15"/></StackPane.margin>
                           <children>
                              <Label fx:id="lblApprovalBadge" text="" styleClass="nav-badge, nav-badge-approval"
                                     visible="false" managed="false"/>
                              <Label fx:id="lblHistoryBadge" text="" styleClass="nav-badge"
                                     visible="false" managed="false"/>
                           </children>
                        </HBox>
                     </children>
                  </StackPane>
               </children>
            </VBox>

            <Button text="Préstamos" fx:id="btnPrestamosGroup"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleTogglePrestamosFlyout"/>
            <VBox fx:id="flyoutPrestamos" visible="false" managed="false" spacing="4" prefWidth="235" styleClass="nav-flyout">
               <children>
                  <ToggleButton text="Cargar Préstamo Interno" fx:id="btnPrestamoCargar" toggleGroup="$flyoutPrestamosGroup"
                        maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowPrestamoCargar"/>
                  <StackPane maxWidth="Infinity">
                     <children>
                        <!-- Not selected="true" — Generar Nota is the real startup section, not
                             this one. -->
                        <ToggleButton text="Historial de Préstamos" fx:id="btnPrestamoHistorial" toggleGroup="$flyoutPrestamosGroup"
                              maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowPrestamoHistorial"/>
                        <HBox spacing="6" alignment="CENTER_RIGHT" mouseTransparent="true"
                              StackPane.alignment="CENTER_RIGHT">
                           <StackPane.margin><Insets right="15"/></StackPane.margin>
                           <children>
                              <Label fx:id="lblPrestamosApprovalBadge" text="" styleClass="nav-badge, nav-badge-approval"
                                     visible="false" managed="false"/>
                              <Label fx:id="lblPrestamosBadge" text="" styleClass="nav-badge"
                                     visible="false" managed="false"/>
                           </children>
                        </HBox>
                     </children>
                  </StackPane>
               </children>
            </VBox>

            <Button text="Envíos" fx:id="btnEnviosGroup"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleToggleEnviosFlyout"/>
            <VBox fx:id="flyoutEnvios" visible="false" managed="false" spacing="4" prefWidth="235" styleClass="nav-flyout">
               <children>
                  <ToggleButton text="Remito de Envío" fx:id="btnRemito" toggleGroup="$flyoutEnviosGroup"
                        maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowRemito"/>
                  <StackPane maxWidth="Infinity">
                     <children>
                        <ToggleButton text="Historial de Envíos" fx:id="btnHistorialEnvios" toggleGroup="$flyoutEnviosGroup"
                              maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowHistorialEnvios"/>
                        <!-- Approval-only, unlike Historial/Préstamos above — Envío has no other
                             pending dimension (no GLPI, no return status), same reasoning already
                             applied to its single in-page pill. -->
                        <HBox spacing="6" alignment="CENTER_RIGHT" mouseTransparent="true"
                              StackPane.alignment="CENTER_RIGHT">
                           <StackPane.margin><Insets right="15"/></StackPane.margin>
                           <children>
                              <Label fx:id="lblEnviosApprovalBadge" text="" styleClass="nav-badge, nav-badge-approval"
                                     visible="false" managed="false"/>
                           </children>
                        </HBox>
                     </children>
                  </StackPane>
               </children>
            </VBox>

            <!-- Separator -->
            <Region maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-min-height: 1; -fx-max-height: 1;">
               <VBox.margin><Insets left="12" right="12" top="4" bottom="4"/></VBox.margin>
            </Region>

            <Button text="Base de Datos" fx:id="btnData"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowDatabase"/>

            <!-- Separator -->
            <Region maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-min-height: 1; -fx-max-height: 1;">
               <VBox.margin><Insets left="12" right="12" top="4" bottom="4"/></VBox.margin>
            </Region>

            <!-- Secondary navigation buttons -->
            <Button text="Mi Perfil" fx:id="btnProfile"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowProfile"/>
            <Button text="Configuración" fx:id="btnSettings"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowSettings"/>
            <Button text="Acerca de" fx:id="btnAbout"
                  maxWidth="Infinity" styleClass="nav-button" onAction="#handleShowAbout"/>

            <!-- Server status — declared hidden/unmanaged here, same "reparented at runtime"
                 pattern as flyoutMovimientos/flyoutPrestamos/flyoutEnvios above.
                 MainController.setupTitleBarStatusHover() moves this into a PopOver's content
                 node and flips visible/managed back to true, anchored off statusPreview above. -->
            <VBox fx:id="statusPanel" spacing="8" visible="false" managed="false"
                  style="-fx-background-color: #0c8570; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.18); -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 10;">
               <children>
                  <Label text="ESTADO DE SERVICIOS" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 9px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                  <!-- Middleware (checked directly by the client) -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <Circle fx:id="circleMiddleware" radius="5.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0" />
                        <Label text="Middleware" style="-fx-text-fill: white; -fx-font-size: 11px;">
                              <tooltip>
                                 <Tooltip fx:id="tooltipMiddleware" text="Verificando estado..." />
                              </tooltip>
                        </Label>
                     </children>
                  </HBox>
                  <!-- Directory / AD (reported by the middleware) -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Circle fx:id="circleDirectory" radius="5.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0" />
                           <Label text="Directorio (AD)" style="-fx-text-fill: white; -fx-font-size: 11px;">
                              <tooltip>
                                 <Tooltip fx:id="tooltipDirectory" text="Verificando estado..." />
                              </tooltip>
                           </Label>
                        </children>
                  </HBox>
                  <!-- Database (reported by the middleware) -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Circle fx:id="circleDb" radius="5.0" fill="#94a3b8" stroke="#ffffff" strokeWidth="1.0" />
                           <Label text="Base de Datos" style="-fx-text-fill: white; -fx-font-size: 11px;">
                              <tooltip>
                                 <Tooltip fx:id="tooltipDb" text="Verificando estado..." />
                              </tooltip>
                           </Label>
                        </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </left>
   
   <center>
      <StackPane fx:id="contentArea">
         <Label text="Seleccione una opción de la barra lateral para comenzar." />
      </StackPane>
   </center>
</BorderPane>