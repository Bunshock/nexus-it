-- Generador de Notas IT — SQLite starting data (equipment catalog + S/N validation + providers)
--
-- This is a TEMPLATE with placeholder rows, not real data — same pattern as
-- config/app-config.json.example and database/postgresql/02-seed-equipment.sql.example. Copy
-- this file to starter-template.sql (gitignored) and replace the example rows below with your
-- organization's actual equipment catalog, S/N validation rules, and provider list before
-- running it. Never commit real inventory, business-partner, or S/N pattern data to this
-- repository.
--
-- Unlike database/postgresql/02-seed-equipment.sql.example, this template DOES cover S/N
-- validation rules (see below) — the Postgres template deliberately leaves those to the app's
-- own UI, but they're plain, non-secret, per-model data with no reason a starting-point script
-- can't cover them too.
--
-- Run against an existing data/noteapp.db (the schema must already exist — start the app once,
-- or run database/sqlite/demo-seed.sql's own instructions apply the same way here):
--   sqlite3 data/noteapp.db < database/sqlite/starter-template.sql
--
-- Idempotent: safe to re-run. Equipment catalog and provider inserts use INSERT OR IGNORE
-- (matching their UNIQUE constraints); MODEL is guarded by its own unique index
-- (brand_type_id, name); S/N validation rows are upserted per model (delete-then-insert), so
-- editing a rule's regex here and re-running replaces it rather than adding a duplicate.

-- ── Equipment catalog ────────────────────────────────────────────────────────────────────────
-- {type, is_asset(1/0), requires_serial(1/0), brand, model or NULL} — NULL model = no specific
-- model configured; the app itself supplies a "Genérico / Otro" fallback option at the UI layer
-- (ItemDialogController.GENERIC_MODEL) whenever a brand+type has no configured model here, so
-- this script deliberately does not need a catch-all model row. requires_serial=1 disables the
-- "Sin S/N" checkbox for that type in the app (ItemDialogController) — only meaningful when
-- is_asset=1 — and is set per row here (not auto-derived from the type name), same as
-- database/postgresql/02-seed-equipment.sql.example, so any type can require it, not just
-- NOTEBOOK.
--
-- EXAMPLE ROWS ONLY — delete these and add your organization's real catalog. They illustrate
-- the pattern: an asset type with two brands and specific models that always requires S/N
-- (NOTEBOOK), an asset type with a model-less brand where the app supplies the fallback option
-- (MONITOR/Genérico), and a countable (non-asset) type (MOUSE).
CREATE TEMP TABLE _seed_rows (
    type_name       TEXT NOT NULL,
    is_asset        INTEGER NOT NULL,
    requires_serial INTEGER NOT NULL,
    brand_name      TEXT NOT NULL,
    model_name      TEXT
);

INSERT INTO _seed_rows (type_name, is_asset, requires_serial, brand_name, model_name) VALUES
('NOTEBOOK', 1, 1, 'Marca Ejemplo A', 'Modelo Ejemplo 14'),
('NOTEBOOK', 1, 1, 'Marca Ejemplo A', 'Modelo Ejemplo 15'),
('NOTEBOOK', 1, 1, 'Marca Ejemplo B', 'Modelo Ejemplo Pro'),
('MONITOR',  1, 0, 'Genérico',        NULL),
('MOUSE',    0, 0, 'Marca Ejemplo A', 'Modelo Ejemplo Inalámbrico'),
('HEADSET',  0, 0, 'Genérico',        NULL);

INSERT OR IGNORE INTO TYPE (name, is_asset, requires_serial)
SELECT DISTINCT type_name, is_asset, requires_serial
FROM _seed_rows;

INSERT OR IGNORE INTO BRAND (name)
SELECT DISTINCT brand_name FROM _seed_rows;

INSERT OR IGNORE INTO BRAND_TYPE_LINK (type_id, brand_id)
SELECT DISTINCT
    (SELECT id FROM TYPE  WHERE name = r.type_name),
    (SELECT id FROM BRAND WHERE name = r.brand_name)
FROM _seed_rows r;

INSERT OR IGNORE INTO MODEL (brand_type_id, name)
SELECT DISTINCT
    (SELECT btl.id FROM BRAND_TYPE_LINK btl
       JOIN TYPE  t ON t.id = btl.type_id  AND t.name = r.type_name
       JOIN BRAND b ON b.id = btl.brand_id AND b.name = r.brand_name),
    r.model_name
FROM _seed_rows r
WHERE r.model_name IS NOT NULL;

DROP TABLE _seed_rows;

-- ── S/N validation rules ─────────────────────────────────────────────────────────────────────
-- One rule per model — matches the exact regex an asset's serial number must satisfy when added
-- through the app (ItemDialogController), same as configuring it via Configuración → Validación
-- de S/N por modelo → Ver tabla (admin mode), just in bulk instead of one at a time. A model
-- with no rule here simply accepts any S/N value, same as today.
--
-- EXAMPLE ROWS ONLY — delete these and add your organization's real patterns. Matches the two
-- NOTEBOOK models above as an example: both require an 11-character uppercase-alphanumeric S/N.
-- description is optional (shown as a hint in the app) — pass NULL to omit it.
CREATE TEMP TABLE _seed_sn_rules (
    type_name     TEXT NOT NULL,
    brand_name    TEXT NOT NULL,
    model_name    TEXT NOT NULL,
    regex_pattern TEXT NOT NULL,
    description   TEXT,
    is_active     INTEGER NOT NULL DEFAULT 1
);

INSERT INTO _seed_sn_rules (type_name, brand_name, model_name, regex_pattern, description, is_active) VALUES
('NOTEBOOK', 'Marca Ejemplo A', 'Modelo Ejemplo 14', '^[A-Z0-9]{11}$', '11 caracteres, letras mayúsculas y números', 1),
('NOTEBOOK', 'Marca Ejemplo A', 'Modelo Ejemplo 15', '^[A-Z0-9]{11}$', '11 caracteres, letras mayúsculas y números', 1);

DELETE FROM SN_VALIDATION
WHERE model_id IN (
    SELECT (SELECT m.id FROM MODEL m
              JOIN BRAND_TYPE_LINK btl ON btl.id = m.brand_type_id
              JOIN TYPE  t ON t.id = btl.type_id  AND t.name = r.type_name
              JOIN BRAND b ON b.id = btl.brand_id AND b.name = r.brand_name
              WHERE m.name = r.model_name)
    FROM _seed_sn_rules r
);

INSERT INTO SN_VALIDATION (model_id, regex_pattern, description, is_active)
SELECT
    (SELECT m.id FROM MODEL m
       JOIN BRAND_TYPE_LINK btl ON btl.id = m.brand_type_id
       JOIN TYPE  t ON t.id = btl.type_id  AND t.name = r.type_name
       JOIN BRAND b ON b.id = btl.brand_id AND b.name = r.brand_name
       WHERE m.name = r.model_name),
    r.regex_pattern, r.description, r.is_active
FROM _seed_sn_rules r;

DROP TABLE _seed_sn_rules;

-- ── Providers ────────────────────────────────────────────────────────────────────────────────
-- Nota de Proveedor's "PROVEEDOR" dropdown (managed at Configuración → Base de Datos →
-- Proveedores, admin mode) — EXAMPLE ROWS ONLY, replace with your organization's actual
-- provider list. No type/brand/model structure — just a flat, unique name.
INSERT OR IGNORE INTO PROVIDER (name) VALUES
('Proveedor Ejemplo S.A.'),
('Distribuidora Ejemplo S.R.L.');
