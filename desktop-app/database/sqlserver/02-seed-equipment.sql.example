-- Generador de Notas IT — SQL Server starting data (equipment catalog + S/N validation +
-- provider catalog)
--
-- This is a TEMPLATE with placeholder rows, not real data — mirroring how
-- config/app-config.json.example works for app-config.json, and the same pattern as
-- database/sqlite/starter-template.sql.example (the equivalent template for the local SQLite
-- database). Copy this file to 02-seed-equipment.sql (gitignored) and replace the example rows
-- below with your organization's actual equipment catalog, S/N validation rules, and provider
-- list before running it. Never commit real inventory, S/N pattern, or business-partner data to
-- this repository.
--
-- Run this AFTER 01-schema.sql (or after launching the app once against this database, which
-- creates the schema automatically via RemoteDatabaseService.ensureSchema()).
--
-- Idempotent: safe to re-run. Every insert below is guarded by a NOT EXISTS check against the
-- relevant unique key (name, or for MODEL, brand_type_id + name — the same unique index
-- RemoteDatabaseService.ensureSchema() creates alongside the table, same as the local SQLite
-- schema) instead of T-SQL's more awkward MERGE, so re-running only inserts rows that don't
-- already exist. S/N validation rows are replaced (delete-then-insert) per model, so editing a
-- rule and re-running updates it rather than duplicating it.

BEGIN TRANSACTION;

IF NOT EXISTS (SELECT 1 FROM BRAND WHERE name = 'Generic')
    INSERT INTO BRAND (name) VALUES ('Generic');

CREATE TABLE #_seed_rows (
    type_name       NVARCHAR(255) NOT NULL,
    is_asset        INT NOT NULL,
    requires_serial INT NOT NULL,
    brand_name      NVARCHAR(255) NOT NULL,
    model_name      NVARCHAR(255)
);

-- {type, is_asset(1/0), requires_serial(1/0), brand, model or NULL} — NULL model = no specific
-- model. The catalog only holds real, curated entries; a "Genérico / Otro" fallback option is
-- provided by the app itself at the UI layer (ItemDialogController.GENERIC_MODEL) whenever a
-- brand+type has no configured model here — this script deliberately does NOT insert a catch-all
-- model row. requires_serial=1 disables the "Sin S/N" checkbox for that type in the app
-- (ItemDialogController) — only meaningful when is_asset=1.
--
-- EXAMPLE ROWS ONLY — replace with your organization's real catalog. A few illustrate the
-- pattern: an asset type with two brands and specific models that always requires S/N (NOTEBOOK),
-- an asset type with a model-less brand where the app supplies the fallback model option
-- (MONITOR/Genérico), and a countable (non-asset) type (MOUSE).
INSERT INTO #_seed_rows (type_name, is_asset, requires_serial, brand_name, model_name) VALUES
('NOTEBOOK', 1, 1, N'Marca Ejemplo A', N'Modelo Ejemplo 14'),
('NOTEBOOK', 1, 1, N'Marca Ejemplo A', N'Modelo Ejemplo 15'),
('NOTEBOOK', 1, 1, N'Marca Ejemplo B', N'Modelo Ejemplo Pro'),
('MONITOR', 1, 0, N'Genérico', NULL),
('MOUSE', 0, 0, N'Marca Ejemplo A', N'Modelo Ejemplo Inalámbrico'),
('HEADSET', 0, 0, N'Genérico', NULL);

-- Types
INSERT INTO TYPE (name, is_asset, requires_serial)
SELECT DISTINCT s.type_name, s.is_asset, s.requires_serial
FROM #_seed_rows s
WHERE NOT EXISTS (SELECT 1 FROM TYPE t WHERE t.name = s.type_name);

-- Brands
INSERT INTO BRAND (name)
SELECT DISTINCT s.brand_name
FROM #_seed_rows s
WHERE NOT EXISTS (SELECT 1 FROM BRAND b WHERE b.name = s.brand_name);

-- Brand-Type links
INSERT INTO BRAND_TYPE_LINK (type_id, brand_id)
SELECT DISTINCT t.id, b.id
FROM #_seed_rows s
JOIN TYPE t ON t.name = s.type_name
JOIN BRAND b ON b.name = s.brand_name
WHERE NOT EXISTS (
    SELECT 1 FROM BRAND_TYPE_LINK btl WHERE btl.type_id = t.id AND btl.brand_id = b.id
);

-- Models (rows with a specific model_name)
INSERT INTO MODEL (brand_type_id, name)
SELECT btl.id, s.model_name
FROM #_seed_rows s
JOIN TYPE t ON t.name = s.type_name
JOIN BRAND b ON b.name = s.brand_name
JOIN BRAND_TYPE_LINK btl ON btl.type_id = t.id AND btl.brand_id = b.id
WHERE s.model_name IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM MODEL m WHERE m.brand_type_id = btl.id AND m.name = s.model_name);

DROP TABLE #_seed_rows;

-- S/N validation rules — one rule per model, matching the exact regex an asset's serial number
-- must satisfy when added through the app (ItemDialogController), same as configuring it via
-- Configuración → Validación de S/N por modelo → Ver tabla (admin mode), just in bulk instead of
-- one at a time. A model with no rule here simply accepts any S/N value, same as today.
--
-- EXAMPLE ROWS ONLY — replace with your organization's real patterns. Matches the two NOTEBOOK
-- models seeded above as an example: both require an 11-character uppercase-alphanumeric S/N.
-- The "Patrón esperado" hint shown in the app is always derived from regex_pattern itself, not
-- a separately stored description.
CREATE TABLE #_seed_sn_rules (
    type_name     NVARCHAR(255) NOT NULL,
    brand_name    NVARCHAR(255) NOT NULL,
    model_name    NVARCHAR(255) NOT NULL,
    regex_pattern NVARCHAR(MAX) NOT NULL,
    is_active     INT NOT NULL DEFAULT 1
);

INSERT INTO #_seed_sn_rules (type_name, brand_name, model_name, regex_pattern, is_active) VALUES
(N'NOTEBOOK', N'Marca Ejemplo A', N'Modelo Ejemplo 14', '^[A-Z0-9]{11}$', 1),
(N'NOTEBOOK', N'Marca Ejemplo A', N'Modelo Ejemplo 15', '^[A-Z0-9]{11}$', 1);

DELETE FROM SN_VALIDATION
WHERE model_id IN (
    SELECT m.id
    FROM #_seed_sn_rules r
    JOIN TYPE t ON t.name = r.type_name
    JOIN BRAND b ON b.name = r.brand_name
    JOIN BRAND_TYPE_LINK btl ON btl.type_id = t.id AND btl.brand_id = b.id
    JOIN MODEL m ON m.brand_type_id = btl.id AND m.name = r.model_name
);

INSERT INTO SN_VALIDATION (model_id, regex_pattern, is_active)
SELECT m.id, r.regex_pattern, r.is_active
FROM #_seed_sn_rules r
JOIN TYPE t ON t.name = r.type_name
JOIN BRAND b ON b.name = r.brand_name
JOIN BRAND_TYPE_LINK btl ON btl.type_id = t.id AND btl.brand_id = b.id
JOIN MODEL m ON m.brand_type_id = btl.id AND m.name = r.model_name;

DROP TABLE #_seed_sn_rules;

-- Providers (Nota de Proveedor's "PROVEEDOR" dropdown, managed at Configuración → Base de
-- Datos → Proveedores, admin mode) — EXAMPLE ROWS ONLY, replace with your organization's
-- actual provider list. Unlike the equipment catalog above, providers have no type/brand/model
-- structure — just a flat, unique name.
IF NOT EXISTS (SELECT 1 FROM PROVIDER WHERE name = N'Proveedor Ejemplo S.A.')
    INSERT INTO PROVIDER (name) VALUES (N'Proveedor Ejemplo S.A.');
IF NOT EXISTS (SELECT 1 FROM PROVIDER WHERE name = N'Distribuidora Ejemplo S.R.L.')
    INSERT INTO PROVIDER (name) VALUES (N'Distribuidora Ejemplo S.R.L.');

COMMIT TRANSACTION;
